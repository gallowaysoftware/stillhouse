# Production secrets for compose.prod.yaml. Copy to .env (gitignored),
# fill in real values, chmod 600 it on the deploy host.
#
# Generate strong passwords with: openssl rand -base64 32

# Postgres superuser password — used by the postgres container itself and
# by the app's ADMIN_DATABASE_URL (migrations + role bootstrap).
PG_ADMIN_PASSWORD=replace-me-with-a-strong-password

# Password for the stillhouse_app role (the non-superuser the running
# server connects with). The app rotates the migration default to this
# value on every boot, so changing it here + restarting the stack is
# enough to rotate. Must NOT contain the sequence '$$'.
PG_APP_PASSWORD=replace-me-with-a-different-strong-password

# Where Stillhouse's data lives on the host. Any path on a real disk; the
# stack appends /postgres for the database and reads the alcoholometric
# tables from /alcoholometric-tables. On Unraid this is typically
# somewhere under the host appdata directory.
STILLHOUSE_DATA_DIR=/srv/stillhouse

# Image to deploy. Build and push your own with `make image-push`; pin a
# specific SHA in production rather than tracking :latest.
STILLHOUSE_IMAGE=registry.example.com/stillhouse:latest

# The external network the app's macvlan attaches to. On Unraid this is
# usually `br0`.
COMPOSE_NETWORK_EXTERNAL=br0

# LAN IP the app binds to on that network. The app is reachable at this IP
# on port 8080 with no extra port-forward; point your reverse proxy at
# WEB_IPV4:8080 for TLS.
#
# Not using macvlan? See the note at the top of compose.prod.yaml for how
# to publish an ordinary port instead.
WEB_IPV4=10.0.0.50
