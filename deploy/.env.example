# Production secrets for compose.prod.yaml. Copy to .env (which is
# gitignored), fill in real values, and chmod 600 it on the deploy host.
#
# Generate strong passwords with: openssl rand -base64 32

# Postgres superuser password — used by the postgres container itself and
# by the app's ADMIN_DATABASE_URL (migrations + role bootstrap).
PG_ADMIN_PASSWORD=replace-me-with-a-strong-password

# Password for the stillhouse_app role (the non-superuser the running
# server connects with). The app rotates the migration default to this
# value on every boot, so changing it here + restarting the stack is
# enough to rotate.
PG_APP_PASSWORD=replace-me-with-a-different-strong-password

# Where the postgres data volume lives on the host. On Unraid:
#   /mnt/user/appdata/stillhouse
# Anywhere else: any path on a real disk (the postgres subdir is appended).
STILLHOUSE_DATA_DIR=/mnt/user/appdata/stillhouse

# Image to deploy. Default points at the local registry. Change to a
# specific tag (recommended for production) e.g.
#   STILLHOUSE_IMAGE=registry.home.thegalloways.ca/stillhouse:abc1234
STILLHOUSE_IMAGE=registry.home.thegalloways.ca/stillhouse:latest

# Host port for the app. NPM / Caddy proxies to localhost:$STILLHOUSE_PORT.
STILLHOUSE_PORT=8080
